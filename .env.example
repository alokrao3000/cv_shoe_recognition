# Copy to .env and fill in. Secrets stay server-side; nothing here is ever sent to the browser.

# ── This project's database (docker compose up -d postgres) ──
DATABASE_URL=postgresql+psycopg2://cvshoe:cvshoe_dev@localhost:5434/cv_shoe_recognition

# ── Read-only source for seeding reference products/images and the eval set ──
# sneaker-arbitrage's Postgres (that repo's docker-compose exposes it on 5433).
ARBITRAGE_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5433/sneaker_arbitrage

# ── Server ──
HOST=0.0.0.0
PORT=8100
# Optional: require `Authorization: Bearer <token>` on /api/* (leave empty for local use)
API_TOKEN=
RATE_LIMIT_PER_MINUTE=60

# ── StockX official API (developer.stockx.com) ──
# Same developer app as sneaker-arbitrage is fine, but get THIS project its own
# refresh token with `python scripts/stockx_auth.py` (two processes rotating one
# refresh token invalidate each other).
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_API_KEY=
STOCKX_REFRESH_TOKEN=
STOCKX_REDIRECT_URI=http://localhost:8018/stockx/callback
STOCKX_CACHE_TTL_HOURS=24

# ── Vision LLM (Anthropic) — brand/model/colorway analysis + candidate verification ──
ANTHROPIC_API_KEY=
VISION_ENABLED=true
VISION_MODEL=claude-opus-5

# ── Web search (style-code discovery + reference photos) ──
SEARCH_PROVIDER=serper
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=10

# ── Embeddings ──
EMBEDDING_MODEL=facebook/dinov2-base
EMBEDDING_POOLING=cls
EMBEDDING_TOP_K=10
EMBEDDING_FLOOR=0.70
EMBEDDING_CEILING=0.92

# ── Identity-match scoring weights (must sum to 1.0) ──
WEIGHT_SKU_MATCH=0.40
WEIGHT_MODEL_MATCH=0.20
WEIGHT_COLORWAY_MATCH=0.15
WEIGHT_EMBEDDING_SIMILARITY=0.15
WEIGHT_METADATA_MATCH=0.05
WEIGHT_EXTERNAL_AGREEMENT=0.05

# ── Confidence tiers ──
CONFIDENCE_HIGH=0.95
CONFIDENCE_MEDIUM=0.85
CONFIDENCE_LOW=0.70
AMBIGUITY_MARGIN=0.05
VERIFICATION_TOP_N=3

# ── Resolution cache (same images + page → reuse a prior HIGH/MEDIUM result) ──
RESOLUTION_CACHE_TTL_HOURS=168
