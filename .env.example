# Copy this file to .env and fill in your values

# ── Reference-image source ──
# Read-only connection to the sneaker-arbitrage Postgres DB — the source of
# (sku, name, image_url) rows used to build the reference embedding index.
# scripts/build_reference_index.py is the only thing that touches this; the
# identify service itself never connects to it.
ARBITRAGE_DATABASE_URL=postgresql://arbitrage:arbitrage_dev@localhost:5432/sneaker_arbitrage

# ── StockX official API (developer.stockx.com) ──
# Same developer app as sneaker-arbitrage (STOCKX_CLIENT_ID/SECRET/API_KEY can
# be reused), but get THIS project its own refresh token via
# `python scripts/stockx_auth.py` rather than copying the other app's —
# two processes rotating the same refresh token can race and invalidate each
# other's session.
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_API_KEY=
STOCKX_REFRESH_TOKEN=          # populated by scripts/stockx_auth.py — do not hand-edit after first run
STOCKX_REDIRECT_URI=http://localhost:8018/stockx/callback

# ── Identification ──
HOST=0.0.0.0
PORT=8100
EMBEDDING_MODEL=facebook/dinov2-base
# Cosine-similarity floor for the top match to count as a confident ID.
MIN_MATCH_SIMILARITY=0.80
# Minimum gap between the top-1 and top-2 candidate's similarity — a
# near-tie usually means two colorways of the same silhouette, not a clean
# match, so treat it as ambiguous instead of guessing.
MIN_MATCH_MARGIN=0.03
TOP_K=5

# ── Coverage backfill (scripts/backfill_stockx_images.py) ──
# See README §Reference coverage gap — currently blocked by Cloudflare from
# this dev environment; untested whether that's environment-specific.
BROWSER_HEADLESS=true
STOCKX_IMAGE_SCRAPE_DELAY_MIN=2.0
STOCKX_IMAGE_SCRAPE_DELAY_MAX=5.0
